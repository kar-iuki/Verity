# Supabase project URL and anon key.
# Dashboard -> Project Settings -> API. Do not put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave unset when Vite proxies /api to the backend on this machine.
# Set this only if the API is hosted on a different origin.
# VITE_API_URL=