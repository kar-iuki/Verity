# Vite proxies /api to the local backend during development.
# That proxy is why the dev server does not need an API base URL.
# VITE_API_URL is only for a separate API host.
# Leave it commented out unless the frontend and API are deployed apart.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# VITE_API_URL=
